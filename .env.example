# 사용할 AI 제공자: gemini 또는 groq (둘 다 무료 티어 제공)
AI_PROVIDER=gemini

# Google Gemini API 키 (무료, 카드 등록 불필요)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API 키 (무료, 카드 등록 불필요) - AI_PROVIDER=groq 일 때 사용
# 발급: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 서버 포트
PORT=3000

# 시험 제한 시간(분)
EXAM_MINUTES=60

# 전체 시험 동안 응시자가 AI와 주고받을 수 있는 최대 메시지 수
MAX_AI_MESSAGES=40
