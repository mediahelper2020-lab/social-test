# 사용할 AI 제공자: gemini 또는 groq (둘 다 무료 티어 제공)
AI_PROVIDER=gemini

# Google Gemini API 키 (무료, 카드 등록 불필요)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq API 키 (무료, 카드 등록 불필요) - AI_PROVIDER=groq 일 때 사용
# 발급: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 서버 포트
PORT=3000

# 문항 1개당 제한 시간(분). 실제 시험 시간 = 선택한 영역의 문항 수 × 이 값
EXAM_MINUTES_PER_QUESTION=12

# 영역 하나의 시험 시간이 아무리 길어도 넘지 않는 최대값(분)
EXAM_MAX_MINUTES=30

# 전체 시험 동안 응시자가 AI와 주고받을 수 있는 최대 메시지 수
MAX_AI_MESSAGES=20
